        resource.data.userId == request.auth.uid ||
        resource.data.subjectStudentUid == request.auth.uid ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'super_admin') ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'school_admin' && resource.data.schoolId == callerData().schoolId)
      );
      allow create: if isValidId(consentId) && isActiveUser()
        && isValidConsentRecord(incoming(), consentId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(consentId) && isActiveUser()
        && isValidConsentRecord(incoming(), consentId)
        && incoming().id == existing().id && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isSuperAdmin() || existing().userId == request.auth.uid);
      allow delete: if isValidId(consentId) && (isSuperAdmin() || (resource != null && isActiveUser() && existing().userId == request.auth.uid));
    }

    // Audit Logs (Immutable append-only)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (isSchoolAdmin(existing().schoolId) || existing().actorUid == request.auth.uid))
      );
      allow list: if isSignedIn() && (
