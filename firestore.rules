        && (isSuperAdmin() || isSchoolAdmin(incoming().schoolId) || isTeacherOfClass(incoming().schoolId, incoming().classId));
      allow update: if isValidId(taskId) && isActiveUser()
        && isValidStudentTask(incoming(), taskId)
