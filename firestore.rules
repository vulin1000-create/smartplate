        && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isSuperAdmin() || callerData().role == 'school_admin');
      allow delete: if isValidId(foodId) && isSuperAdmin();
    }

    // Meal Logs (Student, Verified Parent, Assigned Class Teacher, School Admin, Super Admin)
    match /meal_logs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (
          existing().studentUid == request.auth.uid ||
          (isActiveUser() && callerData().role == 'parent' && existing().verifiedParentIds is list && request.auth.uid in existing().verifiedParentIds) ||
          isSchoolAdmin(existing().schoolId) ||
          isTeacherOfClass(existing().schoolId, existing().classId)
        ))
      );
      allow list: if isSignedIn() && (
        isBootstrappedSuperAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        (resource.data.verifiedParentIds is list && request.auth.uid in resource.data.verifiedParentIds) ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'super_admin') ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'school_admin' && resource.data.schoolId == callerData().schoolId) ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'teacher' && resource.data.schoolId == callerData().schoolId && callerData().classIds is list && resource.data.classId in callerData().classIds)
      );
      allow create: if isValidId(logId) && isActiveUser()
        && isValidMealLog(incoming(), logId)
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (
          isSuperAdmin() ||
          (incoming().studentUid == request.auth.uid && incoming().schoolId == callerData().schoolId) ||
          (callerData().role == 'parent' && callerData().schoolId == incoming().schoolId && callerData().linkedChildIds is list && incoming().studentUid in callerData().linkedChildIds && incoming().verifiedParentIds is list && request.auth.uid in incoming().verifiedParentIds) ||
