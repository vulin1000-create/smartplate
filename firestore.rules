    // Student Progress (safe null-resource handling + teacher class isolation)
    match /student_progress/{studentUid} {
      allow get: if isValidId(studentUid) && isSignedIn() && (
        isSuperAdmin() ||
        request.auth.uid == studentUid ||
        (resource == null && isActiveUser() && callerData().role == 'parent' && callerData().linkedChildIds is list && studentUid in callerData().linkedChildIds) ||
