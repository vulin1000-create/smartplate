          (isSchoolAdmin(incoming().schoolId) && incoming().role in ['student', 'parent', 'teacher'])
        );
      allow update: if isValidId(userId) && isEmailVerified() && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin() ||
