        && incoming().updatedAt == request.time
        && (
          isSuperAdmin() ||
          request.auth.uid == studentUid ||
          isSchoolAdmin(existing().schoolId) ||
          isTeacherOfClass(existing().schoolId, existing().classId) ||
          (callerData().role == 'parent' && existing().verifiedParentIds is list && request.auth.uid in existing().verifiedParentIds && incoming().diff(existing()).affectedKeys().hasOnly(['growthRecords', 'updatedAt']))
        );
      allow delete: if isValidId(studentUid) && (isSuperAdmin() || request.auth.uid == studentUid);
    }

    // Consent Records
    match /consent_records/{consentId} {
      allow get: if isValidId(consentId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (
          existing().userId == request.auth.uid ||
