        (callerExists() && callerData().status == 'active' && callerData().role == 'super_admin') ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'school_admin' && resource.data.schoolId == callerData().schoolId) ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'teacher' && resource.data.schoolId == callerData().schoolId && resource.data.role == 'student' && resource.data.classIds is list && callerData().classIds is list && callerData().classIds.size() > 0 && resource.data.classIds.hasAny(callerData().classIds))
      );
      allow create: if isValidId(userId) && isEmailVerified() && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (
          isSuperAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().role in ['student', 'parent'] &&
            incoming().status == 'active' &&
            (!('linkedChildIds' in incoming()) || incoming().linkedChildIds.size() == 0) &&
            (!('verifiedParentIds' in incoming()) || incoming().verifiedParentIds.size() == 0)
