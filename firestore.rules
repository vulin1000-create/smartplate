          && incoming().id == existing().id && incoming().schoolId == existing().schoolId
          && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
        allow delete: if isValidId(schoolId) && isValidId(yearId) && (isSuperAdmin() || isSchoolAdmin(schoolId));
      }

      match /classes/{classId} {
        allow get: if isValidId(schoolId) && isValidId(classId) && (isSuperAdmin() || isMemberOfSchool(schoolId));
        allow list: if isSignedIn() && (isBootstrappedSuperAdmin() || (callerExists() && callerData().schoolId == schoolId) || (callerExists() && callerData().role == 'super_admin'));
        allow create: if isValidId(schoolId) && isValidId(classId) && exists(/databases/$(database)/documents/schools/$(schoolId))
          && (isSuperAdmin() || isSchoolAdmin(schoolId))
          && isValidSchoolClass(incoming(), schoolId, classId)
          && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isValidId(schoolId) && isValidId(classId)
          && (isSuperAdmin() || isSchoolAdmin(schoolId))
          && isValidSchoolClass(incoming(), schoolId, classId)
          && incoming().id == existing().id && incoming().schoolId == existing().schoolId
          && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
        allow delete: if isValidId(schoolId) && isValidId(classId) && (isSuperAdmin() || isSchoolAdmin(schoolId));
