        && (
          isSuperAdmin() ||
          isSchoolAdmin(incoming().schoolId) ||
          (callerData().role == 'parent' && incoming().parentUid == request.auth.uid && incoming().status == 'pending')
        );
      allow update: if isValidId(linkId) && isActiveUser()
        && isValidParentChildLink(incoming(), linkId)
        && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (
          isSuperAdmin() ||
          isSchoolAdmin(existing().schoolId) ||
          isTeacherInSchool(existing().schoolId)
        );
      allow delete: if isValidId(linkId) && (isSuperAdmin() || (resource != null && isSchoolAdmin(existing().schoolId)) || (resource != null && isActiveUser() && existing().parentUid == request.auth.uid));
    }

    // Vietnamese Food Database
    match /foods/{foodId} {
      allow get: if isValidId(foodId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(foodId) && isActiveUser()
        && isValidVietnameseFood(incoming(), foodId)
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isSuperAdmin() || callerData().role in ['school_admin', 'teacher']);
      allow update: if isValidId(foodId) && isActiveUser()
