      allow update: if isValidId(menuId) && isActiveUser()
        && isValidMenuPlan(incoming(), menuId)
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isSuperAdmin() || isSchoolAdmin(existing().schoolId) || (isTeacherInSchool(existing().schoolId) && existing().createdByUid == request.auth.uid && existing().status != 'published' && incoming().status in ['draft', 'ai_suggested', 'pending_approval']));
      allow delete: if isValidId(menuId) && (isSuperAdmin() || (resource != null && isSchoolAdmin(existing().schoolId)));
    }

    // Teacher Comments (Assigned class teacher isolation)
    match /teacher_comments/{commentId} {
      allow get: if isValidId(commentId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (
          existing().studentUid == request.auth.uid ||
          existing().teacherUid == request.auth.uid ||
          (isActiveUser() && callerData().role == 'parent' && existing().verifiedParentIds is list && request.auth.uid in existing().verifiedParentIds) ||
          isSchoolAdmin(existing().schoolId) ||
