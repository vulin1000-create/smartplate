        && (isSuperAdmin() || isSchoolAdmin(existing().schoolId) || existing().teacherUid == request.auth.uid);
      allow delete: if isValidId(taskId) && (isSuperAdmin() || (resource != null && isSchoolAdmin(existing().schoolId)) || (resource != null && isActiveUser() && existing().teacherUid == request.auth.uid));
