        (callerExists() && callerData().status == 'active' && callerData().role == 'teacher' && resource.data.schoolId == callerData().schoolId && callerData().classIds is list && resource.data.classId in callerData().classIds)
      );
      allow create: if isValidId(studentUid) && isActiveUser()
