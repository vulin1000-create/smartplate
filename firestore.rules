      allow delete: if isValidId(commentId) && (isSuperAdmin() || (resource != null && isSchoolAdmin(existing().schoolId)) || (resource != null && isActiveUser() && existing().teacherUid == request.auth.uid));
    }

    // Student Tasks
    match /student_tasks/{taskId} {
      allow get: if isValidId(taskId) && isSignedIn() && (isSuperAdmin() || (resource != null && isMemberOfSchool(existing().schoolId)));
      allow list: if isSignedIn() && (
