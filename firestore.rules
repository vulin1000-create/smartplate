        && (isSuperAdmin() || request.auth.uid == studentUid || isSchoolAdmin(incoming().schoolId) || isTeacherOfClass(incoming().schoolId, incoming().classId));
      allow update: if isValidId(studentUid) && isActiveUser()
        && isValidStudentProgress(incoming(), studentUid)
