        (callerExists() && callerData().status == 'active' && callerData().role == 'school_admin' && resource.data.schoolId == callerData().schoolId)
      );
      allow create: if isValidId(logId) && isEmailVerified() && isValidAuditLog(incoming(), logId);
      allow update, delete: if false;
    }

    // AI Usage Logs (Append-only telemetry)
    match /ai_usage_logs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (isSchoolAdmin(existing().schoolId) || existing().userId == request.auth.uid))
      );
      allow list: if isSignedIn() && (
        isBootstrappedSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'super_admin') ||
        (callerExists() && callerData().status == 'active' && callerData().role == 'school_admin' && resource.data.schoolId == callerData().schoolId)
      );
      allow create: if isValidId(logId) && isEmailVerified() && isValidAiUsageLog(incoming(), logId);
      allow update, delete: if false;
    }

    // System Config
    match /system_config/{configId} {
      allow get: if configId == 'global' && isSignedIn();
      allow list: if false;
      allow create, update: if configId == 'global' && isSuperAdmin() && isValidSystemConfig(incoming(), configId);
      allow delete: if false;
    }

    // Notifications
    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && isSignedIn() && (isSuperAdmin() || (resource != null && existing().recipientUid == request.auth.uid));
      allow list: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isBootstrappedSuperAdmin() || (callerExists() && callerData().role == 'super_admin'));
      allow create: if isValidId(notifId) && isActiveUser() && isValidNotification(incoming(), notifId)
        && incoming().createdAt == request.time
        && (isSuperAdmin() || isSchoolAdmin(incoming().schoolId) || isTeacherInSchool(incoming().schoolId) || incoming().recipientUid == request.auth.uid);
      allow update: if isValidId(notifId) && isActiveUser() && isValidNotification(incoming(), notifId)
        && existing().recipientUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isValidId(notifId) && (isSuperAdmin() || (resource != null && isActiveUser() && existing().recipientUid == request.auth.uid));
    }
  }
